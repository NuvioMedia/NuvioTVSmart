#!/bin/sh
# Nuvio for Hisense VIDAA: register the boot service and app entry, then start
# the local server. Runs as root from opkg.
export LD_LIBRARY_PATH=/lib:/usr/local/lib:/basic/lib:/3rd/lib:/vendor/lib:/vendor/lib/utopia
PH=/APPS/pkgs/tv.vidaa.app.phoenix/CHA/bin/phoenix
"$PH" /APPS/pkgs/nuvio/setup.cjs install
exit 0
